# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3001

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication & JWT
JWT_SECRET=your-256-bit-jwt-secret-key-here
JWT_EXPIRE=30d

# AI Integration Keys (Server Side Only)
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Telehealth & WebRTC
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud

# Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend Configuration (Client side - prefixed with VITE_)
VITE_API_URL=http://localhost:5000
VITE_LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
